{
  "name": "uitester-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w uitester",
    "build": "npm run build -w @uitester/ui && npm run build -w uitester",
    "start": "node packages/cli/bin/uitester.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "sample": "tsx packages/fixtures/make-sample.ts",
    "fixtures": "tsx packages/fixtures/serve.ts"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
