{
  "name": "joule-monorepo",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w joule",
    "build": "npm run build -w @joule/ui && npm run build -w joule",
    "start": "node packages/cli/bin/joule.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "sample": "tsx packages/fixtures/make-sample.ts",
    "fixtures": "tsx packages/fixtures/serve.ts",
    "desktop": "npm run build -w @joule/ui && npm run start -w joule-desktop",
    "package:desktop": "npm run build -w @joule/ui && npm run package -w joule-desktop"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
