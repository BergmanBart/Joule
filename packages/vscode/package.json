{
  "name": "joule-vscode",
  "displayName": "Joule",
  "description": "Build, maintain and run UI tests visually; saved as Robot Framework files.",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "engines": { "vscode": "^1.85.0" },
  "main": "./dist/extension.js",
  "activationEvents": ["workspaceContains:joule.json"],
  "contributes": {
    "commands": [{ "command": "joule.open", "title": "Joule: Open" }]
  },
  "scripts": {
    "build": "node build.mjs"
  },
  "devDependencies": {
    "@types/vscode": "1.85.0",
    "@joule/server": "*"
  },
  "dependencies": {
    "playwright-core": "1.48.2"
  }
}
